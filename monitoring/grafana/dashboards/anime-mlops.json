          "rawSql": "SELECT f.created_at AS \"time\", p.prediction::double precision AS \"Prédiction\", f.actual_score::double precision AS \"Score réel\" FROM feedbacks f JOIN predictions p ON p.id = f.prediction_id WHERE $__timeFilter(f.created_at) AND p.prediction IS NOT NULL ORDER BY 1",
