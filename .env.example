# Copier ce fichier en ".env" puis adapter les valeurs. Le fichier .env n'est jamais versionné.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=anime
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- MLflow (docker compose) ---
MLFLOW_PORT=5000

# --- Prefect (docker compose) ---
PREFECT_PORT=4200
# Les flows lancés en local s'enregistrent auprès de ce serveur.
PREFECT_API_URL=http://localhost:4200/api

# --- Alertes (optionnel) ---
# Webhook Slack, Discord ou Teams ; sans lui, les alertes restent dans data/reports/alerts.jsonl.
# ANIME_ALERTS__WEBHOOK_URL=

# --- API ---
API_PORT=8000
API_WORKERS=1

# --- Supervision ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Compte PostgreSQL en lecture seule, créé automatiquement pour Grafana.
GRAFANA_DATABASE_USER=grafana_reader
GRAFANA_DATABASE_PASSWORD=change-me-reader

# L'URL interne par défaut fonctionne dès que le service Prefect de A8 est fusionné.
# PREFECT_API_URL=http://prefect:4200/api
# PREFECT_EXPORTER_POLL_SECONDS=15
# PREFECT_EXPORTER_TIMEOUT_SECONDS=3
# PREFECT_EXPORTER_RUN_LIMIT=200

# --- Application (surcharge de configs/config.yaml) ---
# Doit être identique à POSTGRES_PASSWORD.
ANIME_DATABASE__PASSWORD=change-me
