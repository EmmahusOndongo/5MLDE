# Copier ce fichier en ".env" puis adapter les valeurs. Le fichier .env n'est jamais versionné.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=anime
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- MLflow (docker compose) ---
MLFLOW_PORT=5000

# --- API ---
API_PORT=8000
API_WORKERS=1
# Cache local par worker (true/false), borné et expirant.
ANIME_API__CACHE_ENABLED=false
ANIME_API__CACHE_MAX_ENTRIES=10000
ANIME_API__CACHE_TTL_SECONDS=300

# --- Application (surcharge de configs/config.yaml) ---
# Doit être identique à POSTGRES_PASSWORD.
ANIME_DATABASE__PASSWORD=change-me
